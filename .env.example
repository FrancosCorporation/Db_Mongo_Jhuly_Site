# Gere um segredo aleatório com: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=db_mongo_jhuly_site
JWT_AUDIENCE=db_mongo_jhuly_site

# O Compose substitui localhost pelo serviço mongo.

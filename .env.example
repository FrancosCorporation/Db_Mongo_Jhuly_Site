# Preencha para habilitar uploads de fotos.
CLOUDINARY_USER=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Origens web autorizadas, separadas por vírgula.
CORS_ORIGINS=
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=0
